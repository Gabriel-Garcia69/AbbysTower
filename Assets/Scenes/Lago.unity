  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: dio_lago_diario
  kind: 3
  title: Espejos
  text: "Desde la cornisa el lago parece otro cielo.\nMe vi abajo, peque\xF1ita, cruzando las pasarelas. Me salud\xE9. Me salud\xF3."
  signature: "\u2014 A."
  radius: 1.6
  sparkle: {fileID: 1209894308}
