  m_Script: {fileID: 11500000, guid: 542a840e7eae6be4ab0f5de7ba5009ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: dio2_diario
  kind: 3
  title: El mar de adentro
  text: "La torre tambi\xE9n tiene mar. Los barcos est\xE1n amarrados y nadie los suelta.\nUn pescador me cont\xF3 que el capit\xE1n perdi\xF3 su barco en este puerto y se qued\xF3 a esperarlo en la punta del muelle.\nSi vas para all\xE1, no le des la espalda: ataca en abanico."
  signature: "\u2014 A."
  radius: 1.6
  sparkle: {fileID: 1323611134}
