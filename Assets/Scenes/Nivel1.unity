  m_Script: {fileID: 11500000, guid: 542a840e7eae6be4ab0f5de7ba5009ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: p1_3_7559
  kind: 3
  title: "D\xEDa 1"
  text: "El mercader dice que no es la primera vez que me ve. Yo nunca hab\xEDa estado aqu\xED.\n\nLe compr\xE9 una poci\xF3n por si acaso. Me la cobr\xF3 a mitad de precio y me gui\xF1\xF3 un ojo. Qu\xE9 raro."
  signature: "\u2014 A."
  radius: 1.6
  sparkle: {fileID: 1352636248}
