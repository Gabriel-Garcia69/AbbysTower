  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: p3_1_8e62
  kind: 0
  title: Tratado del Buen Descanso
  text: "Cap\xEDtulo I: Ma\xF1ana.\nCap\xEDtulo II: Ma\xF1ana.\nCap\xEDtulo III: Quiz\xE1 pasado ma\xF1ana.\n\n(El resto de las p\xE1ginas est\xE1n en blanco. En la \xFAltima alguien escribi\xF3 con letra muy cansada: \"ya casi\".)"
  signature: 
  radius: 1.6
  sparkle: {fileID: 23970163}
