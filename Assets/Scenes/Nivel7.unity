  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: p7_2_2554
  kind: 3
  title: Lo que jala
  text: "Hay algo en este jard\xEDn que me jala, como cuando quieres algo tanto que ya no importa si duele.\n\nMe amarr\xE9 la espada a la mano para no soltarla. Si me jala, me impulso hacia el otro lado."
  signature: "\u2014 A."
  radius: 1.6
  sparkle: {fileID: 836346913}
