  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: p1_0_2218
  kind: 2
  title: Bienvenida, Ascendiente
  text: "Siete pecados duermen en esta torre, uno encima de otro, como libros en un estante.\n\nQuien llegue a la cima podr\xE1 pedir lo que quiera.\n\nQuien caiga, volver\xE1 a empezar."
  signature: 
  radius: 1.6
  sparkle: {fileID: 2084985406}
