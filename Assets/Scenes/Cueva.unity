  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: dio4_diario
  kind: 3
  title: "Diario de la expedici\xF3n \u2014 d\xEDa 9"
  text: "El piso 5 es una gruta llena de cristales. Brillan con la misma energ\xEDa que usamos en las armas.\nAqu\xED los minerales salen m\xE1s grandes. Con lo de este piso pagar\xEDamos todas las deudas, Abis. Todas."
  signature: "\u2014 Iker"
  radius: 1.6
  sparkle: {fileID: 1363994405}
