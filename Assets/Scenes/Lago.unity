  m_Script: {fileID: 11500000, guid: 542a840e7eae6be4ab0f5de7ba5009ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: dio_lago_diario
  kind: 3
  title: Espejos
  text: "Me asom\xE9 al lago y vi a una ni\xF1a con mi cara, al pie de la torre, mirando hacia arriba. Creo que as\xED empez\xF3 todo.\nDesde esta cornisa se ve el camino entero: las pasarelas, las islas y la cascada. Arriba espera la Dama del Lago."
  signature: "\u2014 A."
  radius: 1.6
  sparkle: {fileID: 1454282556}
