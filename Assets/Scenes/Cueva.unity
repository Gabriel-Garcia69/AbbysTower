  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: dio4_geoda
  kind: 2
  title: Grabado en la piedra
  text: "Al fondo de la gruta, una piedra que late como un coraz\xF3n.\nLos canalizadores dicen que la energ\xEDa de la torre sale de aqu\xED, o pasa por aqu\xED. Nadie lo ha confirmado."
  signature: 
  radius: 1.6
  sparkle: {fileID: 1131074198}
