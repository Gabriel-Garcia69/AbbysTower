  m_Script: {fileID: 11500000, guid: 542a840e7eae6be4ab0f5de7ba5009ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: dio_cascadas_diario
  kind: 3
  title: "Diario de la expedici\xF3n \u2014 d\xEDa 4"
  text: "Aqu\xED no se oye la torre, solo el agua. Descansamos en el campamento de la ladera.\nPens\xE9 en ti, Abis. Te gustar\xEDa este lugar. Me promet\xED que vas a seguir estudiando aunque yo no est\xE9 para verlo."
  signature: "\u2014 Iker"
  radius: 1.6
  sparkle: {fileID: 1302692390}
