  m_Script: {fileID: 11500000, guid: 542a840e7eae6be4ab0f5de7ba5009ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: dio1_diario
  kind: 3
  title: "D\xEDa 1"
  text: "Las chimeneas echan humo, pero nadie abre la puerta.\nEn mi bolsa encontr\xE9 esta libreta y ya ten\xEDa p\xE1ginas escritas con mi letra. No recuerdo haberlas escrito.\nVoy a ir dejando hojas por el camino, por si me toca empezar otra vez."
  signature: "\u2014 A."
  radius: 1.6
  sparkle: {fileID: 113084768}
