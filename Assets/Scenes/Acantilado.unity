  m_Script: {fileID: 11500000, guid: 542a840e7eae6be4ab0f5de7ba5009ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: dio3_diario
  kind: 3
  title: "Diario de la expedici\xF3n \u2014 d\xEDa 6"
  text: 'En este piso el sol nunca termina de ponerse. Cruzamos los puentes colgantes de uno en uno.

    La criatura del faro salta desde lo alto: cuando su sombra cae al suelo, hay que moverse.'
  signature: "\u2014 Dante"
  radius: 1.6
  sparkle: {fileID: 43932270}
