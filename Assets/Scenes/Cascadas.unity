  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: dio_cascadas_diario
  kind: 3
  title: Ruido de agua
  text: "Aqu\xED no se oye la torre, solo el agua.\nLa otra vez llegu\xE9 a las Gemelas sin descansar y no me fue bien. En la ladera del tercer bancal hay un campamento con mercader y un santuario: \xFAsalos antes de seguir."
  signature: "\u2014 A."
  radius: 1.6
  sparkle: {fileID: 1173814479}
