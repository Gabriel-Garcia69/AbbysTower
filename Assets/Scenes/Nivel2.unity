  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: p2_0_3838
  kind: 3
  title: "Las galer\xEDas"
  text: "Las galer\xEDas cuelgan del vac\xEDo. Alguien construy\xF3 esto para que solo subieran los que saben saltar\u2026 o los que no le tienen miedo a caer.\n\nYo s\xED le tengo miedo. Subo igual."
  signature: "\u2014 A."
  radius: 1.6
  sparkle: {fileID: 588397794}
