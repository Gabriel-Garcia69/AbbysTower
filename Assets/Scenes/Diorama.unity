  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 542a840e7eae6be4ab0f5de7ba5009ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: dio1_diario
  kind: 3
  title: "Diario de la expedici\xF3n \u2014 d\xEDa 1"
  text: "Abby: entramos hoy. El piso 1 parece un pueblo de verdad, con r\xEDo y casas, pero no hay nadie.\nEl capit\xE1n dice que la torre copia lugares, que nadie sabe de d\xF3nde.\nVoy a ir dejando estas hojas. Si un d\xEDa bajas, no lo hagas. Pero si bajas, que te sirvan."
  signature: "\u2014 Dante"
  radius: 1.6
  sparkle: {fileID: 463236750}
