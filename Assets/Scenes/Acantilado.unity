  m_Script: {fileID: 11500000, guid: 542a840e7eae6be4ab0f5de7ba5009ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: dio3_diario
  kind: 3
  title: "El mar al rev\xE9s"
  text: "Desde aqu\xED arriba el mar parece un cielo ca\xEDdo. En este piso el sol nunca termina de ponerse.\nCruc\xE9 los puentes colgantes despacio. La g\xE1rgola del faro salta desde lo alto: cuando veas su sombra en el suelo, mu\xE9vete."
  signature: "\u2014 A."
  radius: 1.6
  sparkle: {fileID: 1304337348}
