  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: dio3_diario
  kind: 3
  title: "El mar al rev\xE9s"
  text: "Desde aqu\xED arriba el mar se ve como un cielo ca\xEDdo. El sol se pone cada vez que llego a esta orilla.\nNo importa a qu\xE9 hora suba: siempre es atardecer en el tercer piso."
  signature: "\u2014 A."
  radius: 1.6
  sparkle: {fileID: 566815625}
