  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: dio2_diario
  kind: 3
  title: "Diario de la expedici\xF3n \u2014 d\xEDa 2"
  text: "El piso 2 tiene mar. Barcos amarrados, gaviotas que vuelan en c\xEDrculos y ni una persona.\nEn la punta del muelle nos atac\xF3 algo que se mov\xEDa como un capit\xE1n sin barco. Ataca en abanico: hay que entrarle de lado."
  signature: "\u2014 Iker"
  radius: 1.6
  sparkle: {fileID: 654630237}
