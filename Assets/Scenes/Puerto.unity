  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: dio2_arquitecto
  kind: 0
  title: Registro del puerto
  text: "Registro militar, piso 2.\nLos barcos no zarpan: m\xE1s all\xE1 de la bah\xEDa el mar no lleva a ning\xFAn lado.\nPrimer piso donde la p\xF3lvora dej\xF3 de servir. Desde aqu\xED, solo armas canalizadas."
  signature: 
  radius: 1.6
  sparkle: {fileID: 1684524274}
