  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: dio6_diario
  kind: 3
  title: "Diario de la expedici\xF3n \u2014 d\xEDa 18"
  text: "Hace un fr\xEDo que no se quita. Dormimos en la posada vac\xEDa.\nAbis, si alg\xFAn d\xEDa lees esto: perd\xF3name por no hacerte caso. Te dije que volver\xEDa, y voy a hacer todo para cumplirlo."
  signature: "\u2014 Iker"
  radius: 1.6
  sparkle: {fileID: 689300627}
