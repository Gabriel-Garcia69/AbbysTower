  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: p9_2_a6af
  kind: 0
  title: "Registro del Arquitecto (\xFAltima p\xE1gina)"
  text: "Constru\xED la torre para encerrar los siete pecados.\n\nMe falt\xF3 el octavo: creer que yo pod\xEDa hacerlo.\n\nAhora el Coronado lleva mi corona y yo soy la torre. Cada piedra. Cada escal\xF3n. Cada vez que alguien cae, lo siento."
  signature: 
  radius: 1.6
  sparkle: {fileID: 519677742}
