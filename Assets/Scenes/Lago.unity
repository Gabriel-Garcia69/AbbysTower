  m_Script: {fileID: 11500000, guid: 542a840e7eae6be4ab0f5de7ba5009ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: dio_lago_diario
  kind: 3
  title: "Diario de la expedici\xF3n \u2014 d\xEDa 12"
  text: "Me asom\xE9 al lago y vi nuestra casa, Abis. La ventana de tu cuarto, con la luz prendida.\nEl capit\xE1n nos sac\xF3 de ah\xED a gritos. Dice que la torre te muestra lo que extra\xF1as para que te quedes."
  signature: "\u2014 Iker"
  radius: 1.6
  sparkle: {fileID: 1847162127}
