  m_Script: {fileID: 11500000, guid: 542a840e7eae6be4ab0f5de7ba5009ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: dio_montana_pie
  kind: 2
  title: "Al pie de la monta\xF1a"
  text: "Piso 9. El camino sube en zigzag hasta la cumbre, y desde la cumbre se baja al siguiente piso.\nSi la monta\xF1a te contesta con otra voz, no le contestes: es una criatura."
  signature: 
  radius: 1.6
  sparkle: {fileID: 1963617127}
