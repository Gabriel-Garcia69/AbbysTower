  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 542a840e7eae6be4ab0f5de7ba5009ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: dio1_bienvenida
  kind: 2
  title: Bienvenida, viajera
  text: "Este pueblo existi\xF3 de verdad, al pie de la torre. Cuando se qued\xF3 vac\xEDo, el Arquitecto lo guard\xF3 aqu\xED adentro para que nadie lo olvidara.\nCada piso de la torre es un recuerdo como este.\nPara subir, vence al guardi\xE1n de cada piso: al caer, su portal se enciende y te lleva al siguiente."
  signature: 
  radius: 1.6
  sparkle: {fileID: 1487482311}
