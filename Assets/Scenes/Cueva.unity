  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: dio4_diario
  kind: 3
  title: Bajo la tierra
  text: "Para subir hay que bajar: este piso de la torre es una gruta.\nLos cristales dan luz propia y suenan cuando pasas cerca. Al fondo, en la isla del centro, hay una piedra que late como un coraz\xF3n."
  signature: "\u2014 A."
  radius: 1.6
  sparkle: {fileID: 2001070784}
