  m_GameObject: {fileID: 1511323653}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 542a840e7eae6be4ab0f5de7ba5009ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: dio7_diario
  kind: 3
  title: "Diario de la expedici\xF3n \u2014 \xFAltima p\xE1gina"
  text: "Abis: llegamos al piso 15 y seguimos. El capit\xE1n dice que ma\xF1ana bajamos hasta el piso 20.\nNadie sabe qu\xE9 hay m\xE1s abajo. Si esta es la \xFAltima hoja que encuentras, no me busques.\nPero si me buscas... sigue las hojas."
  signature: "\u2014 Iker"
  radius: 1.6
  sparkle: {fileID: 680722794}
