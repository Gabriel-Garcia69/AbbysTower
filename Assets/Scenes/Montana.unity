  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: dio_montana_refugio
  kind: 3
  title: Libro del refugio
  text: "Firm\xE9 el libro del refugio. Mi nombre ya estaba ah\xED muchas veces, todas con mi letra y todas diciendo lo mismo: \"esta vez s\xED llego\".\nAs\xED que lo escrib\xED otra vez. Esta vez s\xED llego."
  signature: "\u2014 A."
  radius: 1.6
  sparkle: {fileID: 1258701418}
