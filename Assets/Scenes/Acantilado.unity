  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: dio3_faro
  kind: 2
  title: Placa del faro
  text: "Este faro guiaba a los barcos del puerto de abajo.\nCuando los barcos se quedaron amarrados, la luz ya no tuvo a qui\xE9n guiar, y se apag\xF3."
  signature: 
  radius: 1.6
  sparkle: {fileID: 1250360352}
