  m_EditorClassIdentifier: Assembly-CSharp::LoreNote
  id: dio4_diario
  kind: 3
  title: Bajo la torre
  text: "Baj\xE9 para subir. La torre tiene una gruta en el cuarto piso, como si el suelo de arriba fuera el fondo de un lago.\nLos cristales cantan cuando no los miras."
  signature: "\u2014 A."
  radius: 1.6
  sparkle: {fileID: 1225892335}
